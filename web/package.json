{
  "name": "karaoke-web",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:wire": "cd ../server && uv run python -m karaoke.shell.export_schema --out ../web/src/wire/schema.json && cd ../web && node scripts/gen-wire.mjs",
    "predev": "npm run gen:wire",
    "prebuild": "npm run gen:wire",
    "pretypecheck": "npm run gen:wire",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run src",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "6.1.0",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "signalsmith-stretch": "1.3.2"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "20.17.6",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "eslint": "9.14.0",
    "json-schema-to-typescript": "15.0.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.13.0",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
